# === Database ===
# Primary PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://postgres:password@localhost:5432/sem?schema=public"
# Local PostgreSQL example: postgresql://postgres:password@localhost:5432/sem?schema=public
# Vercel Postgres example: postgres://default:password@host.vercel-storage.com:5432/verceldb?sslmode=require

# === AI ===
# MiniMax API key; never commit a real key.
AI_API_KEY=""
# MiniMax OpenAI-compatible API endpoint.
AI_BASE_URL="https://api.minimax.io/v1"
# MiniMax chat model used by AI features.
AI_MODEL="minimax-m3"
# Embedding model name when semantic search is enabled; no model is configured by default.
EMBEDDING_MODEL=""

# === Cron & Internal ===
# Secret protecting internal API endpoints; generate with: openssl rand -hex 32
INTERNAL_API_SECRET=""
# Secret authenticating scheduled jobs; generate with: openssl rand -hex 32
CRON_SECRET=""

# === Web Push ===
# Browser-safe VAPID public key; generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
# Server-only VAPID private key; generate with: npx web-push generate-vapid-keys
VAPID_PRIVATE_KEY=""
# Contact URI supplied to push services, normally a mailto: address.
VAPID_SUBJECT="mailto:admin@example.com"

# === Sentry ===
# Server-side Sentry project DSN.
SENTRY_DSN=""
# Browser-safe Sentry project DSN.
NEXT_PUBLIC_SENTRY_DSN=""
# Sentry release-upload token; keep secret.
SENTRY_AUTH_TOKEN=""
# Sentry organization slug used during release uploads.
SENTRY_ORG=""
# Sentry project slug used during release uploads.
SENTRY_PROJECT=""

# === App ===
# Canonical public URL used for links and callbacks.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Runtime environment; use development locally and production in deployments.
NODE_ENV="development"
# Set to 1 to disable in-process cron jobs when an external scheduler is used.
CRON_DISABLED=1

# === Generation cheatsheet ===
# openssl rand -hex 32                 → INTERNAL_API_SECRET, CRON_SECRET
# npx web-push generate-vapid-keys     → VAPID_PUBLIC_KEY, VAPID_PRIVATE_KEY
# https://sentry.io/settings/...       → SENTRY_DSN
