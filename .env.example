# ─── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string. Use postgres:// for local dev, and the
# asyncpg-compatible URL form for production.
DATABASE_URL="postgresql://dung:dung@localhost:5432/english_quest?schema=public"

# ─── AI provider (Bailian / Qwen via OpenAI-compatible API) ───────────────
AI_API_KEY=""
AI_BASE_URL="https://coding-intl.dashscope.aliyuncs.com/v1"
AI_MODEL="qwen3.5-plus"

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────
# Generate keys with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_EMAIL="mailto:admin@bonstu.site"

# ─── Internal / cron secrets ──────────────────────────────────────────────
# Used by /api/exp, /api/push/send, /api/seed-phase12, /api/analytics/cron.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=""
CRON_SECRET=""

# ─── User timezone offset (minutes) ───────────────────────────────────────
# Defaults to 420 (ICT / +07:00). Used by src/lib/streak.ts.
USER_TIMEZONE_OFFSET_MINS="420"
